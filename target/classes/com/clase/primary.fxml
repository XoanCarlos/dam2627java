<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.clase.Controller">
   <Label text = "Formulario Básico"/>
   <TextField fx:id="nombre" promptText = "Introduce nombre"/>
   <ComboBox fx:id="combo" />
   <RadioButton fx:id="r1" text="Hombre" />
   <RadioButton fx:id="r2" text="Mujer" />
   <CheckBox fx:id="c1" text="Deporte" />
   <CheckBox fx:id="c2" text="Musica" />
   <CheckBox fx:id="c3" text="Viajes" />

   <Button text="Mostrar" onAction="#mostrar" />
</VBox>

